<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:include filename="$(find zed_wrapper)/urdf/zed_macro.urdf.xacro"/>
    <xacro:include filename="$(find imu_description)/urdf/imu.xacro"/>
    <xacro:include filename="$(find blickfeld_driver)/config/blickfeld_cube1.xacro"/>
    <xacro:arg name="gpu" default="false"/>
    <xacro:arg name="config_dir" default="$(find individual_params)/config/default/autosdv_sensor_kit"/>b

    <xacro:property name="sensor_kit_base_link" default="sensor_kit_base_link"/>

    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>
    <link name="${sensor_kit_base_link}">
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </link>

    <!-- sensor -->
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <!-- Blickfeld Cube 1 LiDAR -->
    <joint name="cube1_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['cube1']['x']}
             ${calibration['sensor_kit_base_link']['cube1']['y']}
             ${calibration['sensor_kit_base_link']['cube1']['z']}"
        rpy="${calibration['sensor_kit_base_link']['cube1']['roll']}
             ${calibration['sensor_kit_base_link']['cube1']['pitch']}
             ${calibration['sensor_kit_base_link']['cube1']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="cube1"/>
    </joint>

    <link name="cube1">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Velodyne VLP-32C LiDAR -->
    <joint name="vlp32c_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['vlp32c']['x']}
             ${calibration['sensor_kit_base_link']['vlp32c']['y']}
             ${calibration['sensor_kit_base_link']['vlp32c']['z']}"
        rpy="${calibration['sensor_kit_base_link']['vlp32c']['roll']}
             ${calibration['sensor_kit_base_link']['vlp32c']['pitch']}
             ${calibration['sensor_kit_base_link']['vlp32c']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="vlp32c"/>
    </joint>

    <link name="vlp32c">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Seyond Robin-W LiDAR -->
    <joint name="robin_w_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['robin_w']['x']}
             ${calibration['sensor_kit_base_link']['robin_w']['y']}
             ${calibration['sensor_kit_base_link']['robin_w']['z']}"
        rpy="${calibration['sensor_kit_base_link']['robin_w']['roll']}
             ${calibration['sensor_kit_base_link']['robin_w']['pitch']}
             ${calibration['sensor_kit_base_link']['robin_w']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="robin_w"/>
    </joint>

    <link name="robin_w">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- imu -->
    <joint name="imu_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['imu_link']['x']}
             ${calibration['sensor_kit_base_link']['imu_link']['y']}
             ${calibration['sensor_kit_base_link']['imu_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['imu_link']['roll']}
             ${calibration['sensor_kit_base_link']['imu_link']['pitch']}
             ${calibration['sensor_kit_base_link']['imu_link']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="imu_link"/>
    </joint>

    <link name="imu_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- gnss -->
    <joint name="gnss_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['gnss_base_link']['x']}
             ${calibration['sensor_kit_base_link']['gnss_base_link']['y']}
             ${calibration['sensor_kit_base_link']['gnss_base_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['gnss_base_link']['roll']}
             ${calibration['sensor_kit_base_link']['gnss_base_link']['pitch']}
             ${calibration['sensor_kit_base_link']['gnss_base_link']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="gnss_base_link"/>
    </joint>
    <link name="gnss_base_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>


    <!-- camera -->
    <joint name="zedxm_camera_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['zedxm_camera_link']['x']}
             ${calibration['sensor_kit_base_link']['zedxm_camera_link']['y']}
             ${calibration['sensor_kit_base_link']['zedxm_camera_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['zedxm_camera_link']['roll']}
             ${calibration['sensor_kit_base_link']['zedxm_camera_link']['pitch']}
             ${calibration['sensor_kit_base_link']['zedxm_camera_link']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="zedxm_camera_link"/>
    </joint>
    <xacro:zed_camera name="zedxm" model="zedxm" custom_baseline="0" enable_gnss="false">
      <origin
        xyz="${calibration['sensor_kit_base_link']['zedxm_camera_link']['x']}
             ${calibration['sensor_kit_base_link']['zedxm_camera_link']['y']}
             ${calibration['sensor_kit_base_link']['zedxm_camera_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['zedxm_camera_link']['roll']}
             ${calibration['sensor_kit_base_link']['zedxm_camera_link']['pitch']}
             ${calibration['sensor_kit_base_link']['zedxm_camera_link']['yaw']}"
      />
    </xacro:zed_camera>

    <!-- USB Cameras -->
    <!-- Front USB Camera -->
    <joint name="usb_camera_front_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['usb_camera_front']['x']}
             ${calibration['sensor_kit_base_link']['usb_camera_front']['y']}
             ${calibration['sensor_kit_base_link']['usb_camera_front']['z']}"
        rpy="${calibration['sensor_kit_base_link']['usb_camera_front']['roll']}
             ${calibration['sensor_kit_base_link']['usb_camera_front']['pitch']}
             ${calibration['sensor_kit_base_link']['usb_camera_front']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="usb_camera_front_link"/>
    </joint>
    <link name="usb_camera_front_link">
      <visual>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
    </link>
    <!-- Front camera optical frame -->
    <joint name="usb_camera_front_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
      <parent link="usb_camera_front_link"/>
      <child link="usb_camera_front_optical_link"/>
    </joint>
    <link name="usb_camera_front_optical_link"/>

    <!-- Rear USB Camera -->
    <joint name="usb_camera_rear_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['usb_camera_rear']['x']}
             ${calibration['sensor_kit_base_link']['usb_camera_rear']['y']}
             ${calibration['sensor_kit_base_link']['usb_camera_rear']['z']}"
        rpy="${calibration['sensor_kit_base_link']['usb_camera_rear']['roll']}
             ${calibration['sensor_kit_base_link']['usb_camera_rear']['pitch']}
             ${calibration['sensor_kit_base_link']['usb_camera_rear']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="usb_camera_rear_link"/>
    </joint>
    <link name="usb_camera_rear_link">
      <visual>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
    </link>
    <!-- Rear camera optical frame -->
    <joint name="usb_camera_rear_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
      <parent link="usb_camera_rear_link"/>
      <child link="usb_camera_rear_optical_link"/>
    </joint>
    <link name="usb_camera_rear_optical_link"/>

    <!-- Left USB Camera -->
    <joint name="usb_camera_left_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['usb_camera_left']['x']}
             ${calibration['sensor_kit_base_link']['usb_camera_left']['y']}
             ${calibration['sensor_kit_base_link']['usb_camera_left']['z']}"
        rpy="${calibration['sensor_kit_base_link']['usb_camera_left']['roll']}
             ${calibration['sensor_kit_base_link']['usb_camera_left']['pitch']}
             ${calibration['sensor_kit_base_link']['usb_camera_left']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="usb_camera_left_link"/>
    </joint>
    <link name="usb_camera_left_link">
      <visual>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
    </link>
    <!-- Left camera optical frame -->
    <joint name="usb_camera_left_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
      <parent link="usb_camera_left_link"/>
      <child link="usb_camera_left_optical_link"/>
    </joint>
    <link name="usb_camera_left_optical_link"/>

    <!-- Right USB Camera -->
    <joint name="usb_camera_right_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['usb_camera_right']['x']}
             ${calibration['sensor_kit_base_link']['usb_camera_right']['y']}
             ${calibration['sensor_kit_base_link']['usb_camera_right']['z']}"
        rpy="${calibration['sensor_kit_base_link']['usb_camera_right']['roll']}
             ${calibration['sensor_kit_base_link']['usb_camera_right']['pitch']}
             ${calibration['sensor_kit_base_link']['usb_camera_right']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="usb_camera_right_link"/>
    </joint>
    <link name="usb_camera_right_link">
      <visual>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
    </link>
    <!-- Right camera optical frame -->
    <joint name="usb_camera_right_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
      <parent link="usb_camera_right_link"/>
      <child link="usb_camera_right_optical_link"/>
    </joint>
    <link name="usb_camera_right_optical_link"/>

  </xacro:macro>
</robot>
