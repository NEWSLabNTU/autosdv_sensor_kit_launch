<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="camera_type" default="left"/>
  <arg name="camera_model" default="zedxm" description="Camera model (zedxm, usb, or none)"/>
  <arg name="enable_zed_object_detection" default="false" description="Enable ZED object detection"/>
  <arg name="enable_stereo_output" default="false" description="Enable left/right stereo output (for Isaac SLAM)"/>
  <arg name="use_autoware_converter" default="true" description="Convert ZED objects to Autoware format"/>

  <!-- Individual USB Camera Arguments -->
  <arg name="use_front_camera" default="true"/>
  <arg name="use_rear_camera" default="true"/>
  <arg name="use_left_camera" default="true"/>
  <arg name="use_right_camera" default="true"/>

  <!-- USB Camera Device Arguments -->
  <arg name="front_camera_device" default="/dev/video0"/>
  <arg name="rear_camera_device" default="/dev/video1"/>
  <arg name="left_camera_device" default="/dev/video2"/>
  <arg name="right_camera_device" default="/dev/video3"/>

  <!-- ZED Camera Group -->
  <group if="$(eval &quot;'$(var camera_model)'=='zedxm'&quot;)">
    <!-- Full ZED camera with driver (normal operation) -->
    <include file="$(find-pkg-share autosdv_sensor_kit_launch)/launch/zed_with_object_detection.launch.xml" if="$(var launch_driver)">
      <arg name="camera_name" value="$(var camera_model)"/>
      <arg name="camera_model" value="$(var camera_model)"/>
      <arg name="enable_zed_object_detection" value="$(var enable_zed_object_detection)"/>
      <arg name="enable_stereo_output" value="$(var enable_stereo_output)"/>
      <arg name="use_autoware_converter" value="$(var use_autoware_converter)"/>
    </include>
    <!-- TF-only mode for simulation (no camera driver, just transforms) -->
    <include file="$(find-pkg-share autosdv_sensor_kit_launch)/launch/zed_tf_only.launch.xml" unless="$(var launch_driver)">
      <arg name="camera_name" value="$(var camera_model)"/>
      <arg name="camera_model" value="$(var camera_model)"/>
    </include>
  </group>

  <!-- USB Cameras Group -->
  <group if="$(eval &quot;'$(var camera_model)'=='usb'&quot;)">
    <!-- Front USB Camera -->
    <group if="$(var use_front_camera)">
      <node pkg="gscam" exec="gscam_node" name="usb_camera_front" output="screen">
        <param from="$(find-pkg-share autosdv_sensor_kit_launch)/config/usb_camera_front.yaml"/>
        <remap from="camera/image_raw" to="/sensing/camera/front/image_raw"/>
        <remap from="camera/camera_info" to="/sensing/camera/front/camera_info"/>
      </node>
    </group>

    <!-- Rear USB Camera -->
    <group if="$(var use_rear_camera)">
      <node pkg="gscam" exec="gscam_node" name="usb_camera_rear" output="screen">
        <param from="$(find-pkg-share autosdv_sensor_kit_launch)/config/usb_camera_rear.yaml"/>
        <remap from="camera/image_raw" to="/sensing/camera/rear/image_raw"/>
        <remap from="camera/camera_info" to="/sensing/camera/rear/camera_info"/>
      </node>
    </group>

    <!-- Left USB Camera -->
    <group if="$(var use_left_camera)">
      <node pkg="gscam" exec="gscam_node" name="usb_camera_left" output="screen">
        <param from="$(find-pkg-share autosdv_sensor_kit_launch)/config/usb_camera_left.yaml"/>
        <remap from="camera/image_raw" to="/sensing/camera/left/image_raw"/>
        <remap from="camera/camera_info" to="/sensing/camera/left/camera_info"/>
      </node>
    </group>

    <!-- Right USB Camera -->
    <group if="$(var use_right_camera)">
      <node pkg="gscam" exec="gscam_node" name="usb_camera_right" output="screen">
        <param from="$(find-pkg-share autosdv_sensor_kit_launch)/config/usb_camera_right.yaml"/>
        <remap from="camera/image_raw" to="/sensing/camera/right/image_raw"/>
        <remap from="camera/camera_info" to="/sensing/camera/right/camera_info"/>
      </node>
    </group>
  </group>
</launch>
