<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="lidar_model" default="vlp32c" description="cube1, robin-w, or vlp32c"/>
  <!-- <arg name="host_ip" default="192.168.26.1"/> -->
  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="vehicle_mirror_param_file" default="$(find-pkg-share autosdv_vehicle_description)/config/mirror.param.yaml"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="robin_w_device_ip" default="172.168.1.10"/>
  <arg name="vlp32c_device_ip" default="192.168.7.10"/>

  <!--
    2-D scan production for pose_source:=mcl. The kit owns this because the
    choice of ring depends on this sensor's mounting on this vehicle; MCL takes
    whatever LaserScan appears on scan_topic and resolves the offset itself. See
    docs/design/mcl-user-setup-ux.md.

    Only the spinning vlp32c dispatches a scan producer. Robin-W and Cube1 are
    solid-state with restricted fields of view: their channel index is not a
    constant elevation, so ring extraction would not produce a horizontal plane,
    and a narrow FOV constrains MCL poorly against a 360 degree grid regardless.

    scan_ring has no default on purpose. There is no safe one: the horizontal
    channel is sensor-specific and not the middle index; measured on the
    Autoware sample bag's VLS128 it is 71 of 0..127. Measure yours with
    scripts/sensor/inspect_rings.py, which reports per-channel elevation and
    warns when a ring points too far up to ever meet the ground.
  -->
  <arg name="publish_scan" default="false"
       description="publish a 2-D LaserScan for pose_source:=mcl"/>
  <arg name="scan_ring" default=""
       description="ring/channel to extract; measure with inspect_rings.py"/>
  <arg name="scan_topic" default="/scan_raw"
       description="LaserScan topic MCL's normaliser consumes"/>
  <arg name="scan_input_topic" default="/sensing/lidar/top/pointcloud_raw_ex"
       description="3-D cloud to extract the ring from"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <group>
      <group if="$(eval &quot;'$(var lidar_model)'=='cube1'&quot;)">
	<include file="$(find-pkg-share autosdv_sensor_kit_launch)/launch/cube1.launch.py" if="$(var launch_driver)">
	</include>
      </group>

      <group if="$(eval &quot;'$(var lidar_model)'=='robin-w'&quot;)">
	<include file="$(find-pkg-share autosdv_sensor_kit_launch)/launch/seyond_robin_w.launch.xml" if="$(var launch_driver)">
          <arg name="device_ip" value="$(var robin_w_device_ip)"/>
          <arg name="frame_id" value="robin_w"/>
	</include>
      </group>

      <group if="$(eval &quot;'$(var lidar_model)'=='vlp32c'&quot;)">
        <include file="$(find-pkg-share nebula_ros)/launch/velodyne_launch_all_hw.xml" if="$(var launch_driver)">
          <arg name="sensor_model" value="VLP32"/>
          <arg name="launch_hw" value="$(var launch_driver)"/>
          <arg name="config_file" value="$(find-pkg-share autosdv_sensor_kit_launch)/config/VLP32.param.yaml"/>
        </include>
      </group>
    </group>

    <group if="$(var publish_scan)">
      <include file="$(find-pkg-share autosdv_sensor_kit_launch)/launch/scan_from_ring.launch.xml">
        <arg name="input_topic" value="$(var scan_input_topic)"/>
        <arg name="output_topic" value="$(var scan_topic)"/>
        <arg name="ring" value="$(var scan_ring)"/>
      </include>
    </group>

    <include file="$(find-pkg-share autosdv_sensor_kit_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="lidar_model" value="$(var lidar_model)"/>
    </include>
  </group>
</launch>
