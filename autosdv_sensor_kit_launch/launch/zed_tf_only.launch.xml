<?xml version="1.0"?>
<!--
  ZED Camera TF-Only Launch

  This launch file publishes only the ZED camera TF transforms without running
  the actual camera driver. Used for logging simulation mode where camera data
  comes from rosbag but TF transforms are still needed.

  Publishes:
  - Camera frames from the vendor URDF (via robot_state_publisher)
  - IMU link, via zed_imu_tf.launch.xml, which owns the fallback geometry
-->
<launch>
  <arg name="camera_name" default="zedxm" description="Camera name"/>
  <arg name="camera_model" default="zedxm" description="Camera model (zed, zedm, zed2, zed2i, zedx, zedxm)"/>

  <!-- Robot State Publisher for ZED URDF/TF (no camera driver needed) -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="$(var camera_name)_state_publisher" namespace="/sensing/camera/$(var camera_name)">
    <param name="robot_description"
           value="$(command 'xacro $(find-pkg-share zed_wrapper)/urdf/zed_descr.urdf.xacro camera_name:=$(var camera_name) camera_model:=$(var camera_model)')"/>
    <remap from="robot_description" to="$(var camera_name)_description"/>
  </node>

  <!-- left_camera_frame -> imu_link, which the vendor URDF omits and the
       driver would otherwise publish itself -->
  <include file="$(find-pkg-share autosdv_sensor_kit_launch)/launch/zed_imu_tf.launch.xml">
    <arg name="camera_name" value="$(var camera_name)"/>
  </include>
</launch>
